{
    "buildCommand": "cd 'Premium Interactive DJ Website' && npm install && npm run build",
    "outputDirectory": "Premium Interactive DJ Website/dist",
    "rewrites": [
        {
            "source": "/booking",
            "destination": "/booking.html"
        },
        {
            "source": "/booking/",
            "destination": "/booking.html"
        },
        {
            "source": "/creator",
            "destination": "/creator.html"
        },
        {
            "source": "/creator/",
            "destination": "/creator.html"
        },
        {
            "source": "/analytics",
            "destination": "/analytics.html"
        },
        {
            "source": "/analytics/",
            "destination": "/analytics.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/reels/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=2592000"
                }
            ]
        },
        {
            "source": "/optimized/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=2592000"
                }
            ]
        },
        {
            "source": "/creator/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=2592000"
                }
            ]
        },
        {
            "source": "/analytics/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=2592000"
                }
            ]
        }
    ]
}
